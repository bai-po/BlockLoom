# Local environments and Python caches
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.uv-cache/

# Local IDE paths and Blender development sessions
/.vscode/
/.dev/

# Retired duplicate declarations: the shared unified descriptor is maintained.
/asset/human/LAYER_RESOLUTION_2_4_2.json
/asset/human/LAYER_RESOLUTION_2_4_3.json
/asset/human/LAYER_RESOLUTION_2_4_4.json
/asset/human/LAYER_RESOLUTION_2_4_5.json
/asset/human/LAYER_RESOLUTION_2_4_6.json
