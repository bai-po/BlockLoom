# Local-only test files and directories at any depth
# Place _test before the file extension or at the end of the directory name.
*_test
*_test.*

# Generated checks and build output
.coverage
.coverage.*
/htmlcov/
/coverage.xml
/build/
/dist/
*.egg-info/
*.log

# Blender automatic backups (keep actual .blend resources)
*.blend[0-9]*
